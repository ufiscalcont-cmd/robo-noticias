# Copie para .env (uso local/servidor) ou cadastre como Secrets no GitHub.

# Canais ativos
CANAIS=email,whatsapp
FUSO=America/Sao_Paulo

# ---------- E-mail (Gmail: use uma "Senha de app", não a senha normal) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=465
SMTP_USUARIO=seuemail@gmail.com
SMTP_SENHA=xxxx xxxx xxxx xxxx
EMAIL_DESTINO=seuemail@gmail.com
# EMAIL_REMETENTE=Robô de Notícias <seuemail@gmail.com>

# ---------- WhatsApp ----------
# Provedor: callmebot (grátis, uso pessoal) | zapi | evolution
WHATSAPP_PROVEDOR=callmebot
# Número com DDI + DDD, só dígitos (callmebot aceita com +)
WHATSAPP_NUMERO=5579999999999
# Incluir links no WhatsApp? (deixa a mensagem bem maior)
WHATSAPP_LINKS=false

# CallMeBot
CALLMEBOT_APIKEY=

# Z-API
ZAPI_INSTANCIA=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Evolution API (auto-hospedada)
EVOLUTION_URL=
EVOLUTION_INSTANCIA=
EVOLUTION_APIKEY=
