# Alternativa ao GitHub Actions: servidor/VPS Linux próprio com systemd.
# Copie para /etc/systemd/system/ e ajuste WorkingDirectory e User.
[Unit]
Description=Robô de Notícias (coleta e envio)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=robo
WorkingDirectory=/opt/robo-noticias
ExecStart=/usr/bin/python3 -m noticias_bot
# Se falhar, tenta de novo a cada 10 min até conseguir (o estado evita duplicar)
Restart=on-failure
RestartSec=600
StartLimitIntervalSec=0
